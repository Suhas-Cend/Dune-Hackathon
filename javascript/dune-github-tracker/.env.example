# Copy this file to ".env" and fill in real values. Never commit the real ".env" file.

# --- GitHub access ---
# Personal Access Token (classic) with the "repo" scope is enough to start.
# Create one at: https://github.com/settings/tokens
# (Longer term, see the "GitHub App" note in src/webhookServer.js for a per-org setup
# that doesn't rely on one person's personal token.)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo-name

# --- AI access (Claude, for the code-quality scoring) ---
# Create a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional tuning (safe to leave as-is) ---
# How far back to look for commits/PRs, in days.
LOOKBACK_DAYS=30
# How often the "watch" mode re-checks GitHub, in milliseconds. 300000 = 5 minutes.
POLL_INTERVAL_MS=300000

# --- Only needed if you set up src/webhookServer.js (the GitHub App / instant-updates path) ---
GITHUB_WEBHOOK_SECRET=
PORT=3000
